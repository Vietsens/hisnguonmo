<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpBinding_ICRMRequest">
          <security mode="Message" />
        </binding>
        <binding name="NetTcpBinding_ICRMRequest">
          <security mode="Message" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8099/UAS/CRMRequest" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_ICRMRequest" contract="CRMRequest.ICRMRequest"
        name="NetTcpBinding_ICRMRequest">
        <identity>
          <dns value="localhost" />
        </identity>
      </endpoint>
     
    </client>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
  </startup>
</configuration>