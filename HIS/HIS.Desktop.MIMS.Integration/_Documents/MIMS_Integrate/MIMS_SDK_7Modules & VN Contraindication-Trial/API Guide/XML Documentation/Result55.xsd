<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:element name="Result">
    <xs:complexType>
      <xs:choice>
        <xs:element name="List">
          <xs:complexType>
            <xs:choice>
              <xs:element name="Product" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="ProductLine" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="Molecule" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="listElementType">
                      <xs:attribute name="languageCode" type="xs:language" use="required"/>
                      <xs:attribute name="nameSourceCode" type="xs:string" use="required"/>
                      <xs:attribute name="primaryName" type="xs:boolean" use="optional" fixed="true"/>
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="ActiveCompositionGroup" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="listElementType">
                      <xs:sequence>
                        <xs:element name="Molecules" minOccurs="0">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Molecule" type="listElementType" maxOccurs="unbounded">
                                <xs:annotation>
                                  <xs:documentation>The name is the "primary name" for the molecule.</xs:documentation>
                                </xs:annotation>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="count" type="xs:integer" use="required"/>
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="Products" minOccurs="0">
                          <xs:annotation>
                            <xs:documentation>Appears if the Products element appears in the request.</xs:documentation>
                          </xs:annotation>
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Product" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="reference" type="GUID" use="required"/>
                                  <xs:attribute name="name" type="xs:string" use="required"/>
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="count" type="xs:integer" use="required"/>
                          </xs:complexType>
                        </xs:element>
                      </xs:sequence>
                      <!--xs:attribute name="name" use="optional" /-->
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="ActiveComposition" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="listElementType">
                      <xs:sequence>
                        <xs:element name="Molecules" minOccurs="0">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Molecule" maxOccurs="unbounded">
                                <xs:annotation>
                                  <xs:documentation>The text content of this element may contain free-text Information describing the strength/concentration/potency of the molecule. The molecule names are those marked with primaryName="True" in the List Molecule result.</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                  <xs:attribute name="reference" type="GUID" use="required"/>
                                  <xs:attribute name="name" type="xs:string" use="required"/>
                                  <xs:attribute name="strength" type="nullableDecimalType" use="required"/>
                                  <xs:attribute name="maximumStrength" type="nullableDecimalType" use="required"/>
                                  <xs:attribute name="strengthUnit" type="xs:string" use="required"/>
                                  <xs:attribute name="perVolume" type="nullableDecimalType" use="required"/>
                                  <xs:attribute name="perVolumeUnit" type="xs:string" use="required"/>
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="count" type="xs:integer" use="required"/>
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="Products" minOccurs="0">
                          <xs:annotation>
                            <xs:documentation>Appears if the Products element appears in the request.</xs:documentation>
                          </xs:annotation>
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Product" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="reference" type="GUID" use="required"/>
                                  <xs:attribute name="name" type="xs:string" use="required"/>
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="count" type="xs:integer" use="required"/>
                          </xs:complexType>
                        </xs:element>
                      </xs:sequence>
                      <!--xs:attribute name="name" use="prohibited" /-->
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="GGPI" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="GenericItem" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="SpecificItem" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="AtcClassification" type="listElementCodeType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="TherapeuticClass" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="listElementCodeType">
                      <xs:attribute name="parentCode"/>
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="SubstanceClass" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="HealthIssue" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="HealthIssueCode" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="code" type="xs:string" use="required"/>
                  <xs:attribute name="codeType" type="xs:string" use="required"/>
                  <xs:attribute name="name"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="DSMRouteOfAdmin" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:complexContent>
                    <xs:extension base="removableListElementType">
                      <xs:attribute name="D2D" type="xs:boolean" use="required"/>
                      <xs:attribute name="D2H" type="xs:boolean" use="required"/>
                      <xs:attribute name="D2F" type="xs:boolean" use="required"/>
                    </xs:extension>
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="FoodClass" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="RouteOfAdministration" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="CompanyType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="DocumentType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="Form" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="HL7Form" type="listElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="PackageType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="PriceType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="ProductType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="MoleculeNameSource" type="listElementCodeType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="Unit" type="listElementCodeType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="Package" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="reference" type="GUID" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="PackageIdentifierType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="ProductIdentifierType" type="removableListElementType" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="DoseRangeInterval" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
            <xs:attribute name="total" type="xs:unsignedLong" use="required"/>
            <xs:attribute name="from" type="xs:unsignedLong" use="required"/>
            <xs:attribute name="to" type="xs:unsignedLong" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Detail">
          <xs:complexType>
            <xs:choice>
              <xs:element name="Datafile">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Copyright" type="xs:string"/>
                    <xs:element name="Languages">
                      <xs:annotation>
                        <xs:documentation>Lists the language codes for text in this file. The codes appear in their order of preference. These define the languages that are used to select from GDDB the most appropriate available text for each entity defined in this datafile. Usually
													this list will only be one or two entries long with the final entry being English.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Language">
                            <xs:complexType>
                              <xs:attribute name="code" type="xs:language" use="required"/>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="BuildID"/>
                    <xs:element name="IssueDate"/>
                    <xs:element name="FastTrack">
                      <xs:complexType>
                        <xs:attribute name="version" type="xs:string" use="required"/>
                        <xs:attribute name="buildDate" type="xs:date" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Note"/>
                  </xs:sequence>
                  <xs:attribute name="countryCode" type="xs:string" use="required"/>
                  <xs:attribute name="currencyCode" type="xs:string" use="required"/>
                  <xs:attribute name="dataReleaseDate" type="xs:dateTime" use="required"/>
                  <xs:attribute name="dataSchemaVersion" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="FoodClass">
                <xs:complexType mixed="true">
                  <xs:attribute name="reference" type="GUID" use="required"/>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="Product">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="OffMarketReason" type="xs:string" minOccurs="0"/>
                    <xs:element name="ProductLine">
                      <xs:complexType>
                        <xs:attribute name="reference" type="GUID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="GGPI" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This is missing if the GGPI column value in the GDDB.PRODUCT table is null. That would be the case if at least one item did not have a Specific Item identifier.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:attribute name="reference" type="GUID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ProductType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This is missing if the Product Type column value in GDDB is null.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:attribute name="reference" type="GUID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Items" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the Items element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Item" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="Form">
                                  <xs:complexType>
                                    <xs:attribute name="reference" type="GUID" use="required"/>
                                    <xs:attribute name="name" type="xs:string" use="required"/>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="Routes">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="Route" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                          <xs:attribute name="reference" type="GUID" use="required"/>
                                          <xs:attribute name="name" type="xs:string" use="required"/>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="count" type="xs:integer" use="required"/>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="Images">
                                  <xs:complexType>
                                    <xs:complexContent>
                                      <xs:extension base="imagesType">
                                        <xs:attribute name="count" type="xs:integer" use="required"/>
                                      </xs:extension>
                                    </xs:complexContent>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="ActiveCompositionGroup">
                                  <xs:annotation>
                                    <xs:documentation>Active Compositions with no molecules are not allowed.</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="ActiveComposition">
                                        <xs:complexType>
                                          <xs:sequence>
                                            <xs:element name="Molecules">
                                              <xs:complexType>
                                                <xs:sequence>
                                                  <xs:element name="Molecule" maxOccurs="unbounded">
                                                    <xs:annotation>
                                                      <xs:documentation>The text content of this element may contain free-text Information describing the strength/concentration/potency of the molecule. The molecule names come from those that are identified for this particular product rather than
																												those that are marked primary for the entire dataset.</xs:documentation>
                                                    </xs:annotation>
                                                    <xs:complexType>
                                                      <xs:attribute name="reference" type="GUID" use="required"/>
                                                      <xs:attribute name="name" type="xs:string" use="required"/>
                                                      <xs:attribute name="languageCode" type="xs:language" use="required"/>
                                                      <xs:attribute name="nameSourceCode" type="xs:string" use="required"/>
                                                      <xs:attribute name="strength" type="nullableDecimalType" use="required"/>
                                                      <xs:attribute name="maximumStrength" type="nullableDecimalType" use="required"/>
                                                      <xs:attribute name="strengthUnit" type="xs:string" use="required"/>
                                                      <xs:attribute name="perVolume" type="nullableDecimalType" use="required"/>
                                                      <xs:attribute name="perVolumeUnit" type="xs:string" use="required"/>
                                                    </xs:complexType>
                                                  </xs:element>
                                                </xs:sequence>
                                                <xs:attribute name="count" type="xs:integer" use="required"/>
                                              </xs:complexType>
                                            </xs:element>
                                          </xs:sequence>
                                          <xs:attribute name="reference" type="GUID" use="required"/>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element name="GenericItem" minOccurs="0">
                                        <xs:annotation>
                                          <xs:documentation>This may be null if the global editors have not yet assigned a Specific Item id to this item.</xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                          <xs:sequence>
                                            <xs:element name="HL7Form">
                                              <xs:complexType>
                                                <xs:attribute name="reference" type="GUID" use="required"/>
                                                <xs:attribute name="name" type="xs:string" use="required"/>
                                              </xs:complexType>
                                            </xs:element>
                                            <xs:element name="SpecificItem">
                                              <xs:complexType>
                                                <xs:sequence>
                                                  <xs:element name="Molecules">
                                                    <xs:complexType>
                                                      <xs:sequence>
                                                        <xs:element name="Molecule" maxOccurs="unbounded">
                                                          <xs:annotation>
                                                            <xs:documentation>The molecule names are those marked with primaryName="True" in the List Molecule result.</xs:documentation>
                                                          </xs:annotation>
                                                          <xs:complexType>
                                                            <xs:attribute name="reference" type="GUID" use="required"/>
                                                            <xs:attribute name="name" type="xs:string" use="required"/>
                                                            <xs:attribute name="strength" type="nullableDecimalType" use="required"/>
                                                            <xs:attribute name="maximumStrength" type="nullableDecimalType" use="required"/>
                                                            <xs:attribute name="strengthUnit" type="xs:string" use="required"/>
                                                          </xs:complexType>
                                                        </xs:element>
                                                      </xs:sequence>
                                                      <xs:attribute name="count" type="xs:integer" use="required"/>
                                                    </xs:complexType>
                                                  </xs:element>
                                                </xs:sequence>
                                                <xs:attribute name="reference" type="GUID" use="required"/>
                                                <xs:attribute name="name" type="xs:string" use="required"/>
                                                <xs:attribute name="perVolume" type="nullableDecimalType" use="required"/>
                                                <xs:attribute name="perVolumeUnit" type="xs:string" use="required"/>
                                              </xs:complexType>
                                            </xs:element>
                                          </xs:sequence>
                                          <xs:attribute name="reference" type="GUID" use="required"/>
                                          <xs:attribute name="name" type="xs:string" use="required"/>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="reference" type="GUID" use="required"/>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="reference" type="GUID" use="required"/>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Packages" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the Packages element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Package" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation>Every product must have at least 1 package as a business rule.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:attribute name="reference" type="GUID" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Images" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the Images element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:complexContent>
                          <xs:extension base="imagesType">
                            <xs:attribute name="count" type="xs:integer" use="required"/>
                          </xs:extension>
                        </xs:complexContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="TherapeuticClasses" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the TherapeuticClasses element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TherapeuticClass" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="code" type="xs:string" use="required"/>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ATCCodes" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the ATCCodes element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ATCCode" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="code" type="xs:string" use="required"/>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Companies" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>This appears if the Companies element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Company" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="CompanyType">
                                  <xs:complexType>
                                    <xs:attribute name="reference" type="GUID" use="required"/>
                                    <xs:attribute name="name" type="xs:string" use="required"/>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="reference" type="GUID" use="required"/>
                              <xs:attribute name="name" type="xs:string" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Documents" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Appears if the Documents element is in the request.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Document" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:any/>
                              </xs:sequence>
                              <xs:attribute name="reference" type="GUID" use="required"/>
                              <xs:attribute name="typeReference" type="GUID" use="required"/>
                              <xs:attribute name="stylesheetReference" type="GUID" use="optional"/>
                              <xs:attribute name="schemaReference" type="GUID" use="optional"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Identifiers" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Identifier" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="identifier" type="xs:string" use="required"/>
                              <xs:attribute name="identifierType" type="GUID" use="required"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="count" type="xs:integer" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="CautionaryLabels" minOccurs="0" type="calsType"/>
                  </xs:all>
                  <xs:attribute name="reference" type="GUID" use="required"/>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                  <xs:attribute name="code" type="xs:string" use="required"/>
                  <xs:attribute name="registrationDate" type="xs:date" use="optional"/>
                  <xs:attribute name="onMarketDate" type="xs:date" use="optional"/>
                  <xs:attribute name="offMarketDate" type="xs:date" use="optional"/>
                  <xs:attribute name="hardStop" type="xs:boolean" use="optional" fixed="true"/>
                  <xs:attribute name="offMarket" type="xs:boolean" use="optional"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="Package">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Product">
                      <xs:complexType>
                        <xs:attribute name="reference" type="GUID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="OffMarketReason" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="PackageType" minOccurs="0">
                      <xs:complexType>
                        <xs:attribute name="reference" type="GUID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Items" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Item" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="PackageType" minOccurs="0">
                                  <xs:complexType>
                                    <xs:attribute name="reference" type="GUID" use="required"/>
                                    <xs:attribute name="name" type="xs:string" use="required"/>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="reference" type="GUID" use="required"/>
