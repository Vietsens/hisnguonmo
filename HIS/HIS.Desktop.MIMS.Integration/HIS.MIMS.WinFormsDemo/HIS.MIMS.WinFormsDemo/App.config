<?xml version="1.0" encoding="utf-8" ?>
<configuration>
<configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <log4net>
    <appender name="LogSystem" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\LogSystem.txt"/>
	  <encoding value="utf-8"/>
	  <appendToFile value="true"/>
      <rollingStyle value="Composite"/>
      <maxSizeRollBackups value="30"/>
      <maximumFileSize value="5MB"/>  
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%level %date [%thread] - %message%newline%exception%newline"/>
      </layout>
    </appender>
    <logger name="Inventec.Common.Logging.LogSystem">
      <level value="DEBUG"/>
      <param name="Threshold" value="ERROR"/>
      <appender-ref ref="LogSystem"/>
    </logger>
	<appender name="LogAction" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\LogAction.txt"/>
	  <encoding value="utf-8"/>
	  <appendToFile value="true"/>
      <rollingStyle value="Composite"/>
      <maxSizeRollBackups value="30"/>
      <maximumFileSize value="5MB"/>  
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%level %date [%thread] - %message%newline%exception%newline"/>
      </layout>
    </appender>
    <logger name="Inventec.Common.Logging.LogAction">
      <level value="DEBUG"/>
      <param name="Threshold" value="ERROR"/>
      <appender-ref ref="LogAction"/>
    </logger>
  </log4net>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <appSettings>
  
	<!-- Credentials (MIMS demo environment) -->
    <add key="MIMS.Username" value="District7" />
    <add key="MIMS.Password" value="18jo6Prtux" />
    <add key="MIMS.CDS.ApiUrl" value="http://113.161.51.99:8079/RESTFTWebService/FTRequest/xmlrequestplus" />
    <add key="MIMS.VNContra.ApiUrl" value="http://113.161.51.99:8079/RESTFTWebService/FTRequest/xmlrequestplus-vn" />

    <!-- Path to MIMS stylesheet and resources (relative to EXE folder) -->
    <add key="MIMS.Resource.BasePath" value="Resources\MIMSStyleSheet" />
    <add key="MIMS.StyleSheet.File" value="MIMSStylesheet_CDSDefault_byRanking_VN_1.xsl" />

    <!-- Demo cache loader: base folder containing HIS_ATC/ and HIS_MEDICINE_TYPE/ subfolders -->
    <add key="MIMS.Demo.CsvBasePath" value="d:\Inventec\ivt-dev\Database" />
  </appSettings>
</configuration>
